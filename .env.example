# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อน `docker compose up -d`
# ห้าม commit .env ตัวจริงเข้า git

MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USER=paybox_app
DB_PASS=change-me-app-password
DB_NAME=paybox

STRIPE_SECRET_KEY=sk_live_...
ADMIN_PASSWORD=change-me-admin-password

# อัตราที่ผู้ให้บริการรับชำระเงินเก็บจากคุณ ใช้เป็นพื้นขั้นต่ำของค่าธรรมเนียมที่ตั้งให้ร้านค้า
# ระบบจะไม่ยอมให้ตั้งค่าธรรมเนียมต่ำกว่าหรือเท่ากับค่านี้ เพราะรับประกันว่าขาดทุน
# 1.77 คือค่าที่วัดได้จริงจาก Stripe PromptPay ในไทย ตรวจกับสัญญาของคุณเอง
PROVIDER_FEE_PERCENT=1.77

PAYBOX_MAX_AMOUNT=100000
PAYBOX_CURRENCY=thb
PAYBOX_BILLING_EMAIL=guest@orca-paybox.com
PUBLIC_BASE_URL=https://orca-paybox.com

# จาก Stripe Dashboard > Developers > Webhooks > endpoint ของเรา > Signing secret
# ถ้าไม่ตั้ง /api/stripe/webhook จะตอบ 503 กลับหา Stripe ทุกครั้ง และรายการที่จ่ายสำเร็จ
# จะไม่ถูกอัปเดตจนกว่า reconciler จะไปตามเก็บ
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Ksher — ผู้ให้บริการรับชำระเงินอีกเจ้า เลือกได้ต่อเครื่อง ไม่ตั้งก็ยังใช้ Stripe ได้ตามปกติ
# กุญแจ PEM เขียนเป็นบรรทัดเดียว ใช้ตัวอักษร backslash ตามด้วย n แทนการขึ้นบรรทัดจริง
KSHER_APPID=mch00000
KSHER_PRIVATE_KEY=

# อัตราที่ผู้ให้บริการแต่ละเจ้าเก็บจากเรา ใช้เป็นพื้นขั้นต่ำของค่าธรรมเนียมที่ตั้งให้ร้านค้า
PROVIDER_FEE_PERCENT_STRIPE=1.77
PROVIDER_FEE_PERCENT_KSHER=1.77
