# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อน `docker compose up -d`
# ห้าม commit .env ตัวจริงเข้า git

MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USER=paybox_app
DB_PASS=change-me-app-password
DB_NAME=paybox

STRIPE_SECRET_KEY=sk_live_...
ADMIN_PASSWORD=change-me-admin-password

PAYBOX_MAX_AMOUNT=100000
PAYBOX_CURRENCY=thb
PAYBOX_BILLING_EMAIL=guest@orca-paybox.com
PUBLIC_BASE_URL=https://orca-paybox.com

# จาก Stripe Dashboard > Developers > Webhooks > endpoint ของเรา > Signing secret
# ถ้าไม่ตั้ง /api/stripe/webhook จะตอบ 503 กลับหา Stripe ทุกครั้ง และรายการที่จ่ายสำเร็จ
# จะไม่ถูกอัปเดตจนกว่า reconciler จะไปตามเก็บ
STRIPE_WEBHOOK_SECRET=whsec_xxx
